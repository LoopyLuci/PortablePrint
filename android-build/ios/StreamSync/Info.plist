<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>StreamSync</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.streamsync.ios</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>StreamSync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSBonjourServices</key>
    <array>
        <string>_streamsync._tcp</string>
        <string>_streamsync._udp</string>
        <string>_airplay._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>StreamSync uses the local network to discover nearby devices and transfer files between them. This allows seamless peer-to-peer file sharing and content streaming without needing an internet connection.</string>
    <key>NSBonjourServicesDescription</key>
    <string>StreamSync advertises itself on the local network so other devices can find it for file transfers and streaming.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>bonjour-service</string>
        <string>audio</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>arkit</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>All Documents</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>StreamSync can share photos and videos with connected devices.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>StreamSync needs microphone access for audio streaming features.</string>
    <key>NSCameraUsageDescription</key>
    <string>StreamSync needs camera access for screen mirroring and video streaming.</string>
</dict>
</plist>
